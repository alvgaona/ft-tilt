<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ft_tilt_bringup</name>
  <version>0.1.0</version>
  <description>World, launch files, bridge config and the scripted experiments from RPIC17 / ICRIS18</description>
  <maintainer email="alvgaona@gmail.com">Alvaro Gaona</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>actuator_msgs</depend>
  <depend>ft_tilt_control</depend>

  <exec_depend>ft_tilt_description</exec_depend>
  <exec_depend>ft_tilt_gazebo</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
