<?xml version="1.0"?>
<sdf version="1.11">
  <world name="ft_tilt_world">
    <!-- 1 kHz physics; the flight controller runs at 200 Hz inside it. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Scenery is visual only (models/): the physics is the same flat plane. -->
    <scene>
      <ambient>0.7 0.7 0.72 1</ambient>
      <background>0.62 0.76 0.92 1</background>
      <sky></sky>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Afternoon sun, low enough for long shadows, plus a soft sky fill from the other side so
         shadowed sides aren't black. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.96 0.9 1</diffuse>
      <specular>0.4 0.4 0.38 1</specular>
      <intensity>1.6</intensity>
      <direction>-0.55 0.45 -0.7</direction>
    </light>
    <light type="directional" name="sky_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.6 0.7 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.5 -0.4 -0.75</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <!-- Grass repeated every 5 m (an SDF plane would stretch one texture over 100 m). -->
        <visual name="grass">
          <geometry><mesh><uri>model://ground/meshes/ground.obj</uri></mesh></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://ground/materials/grass.jpg</albedo_map>
              <roughness>0.95</roughness>
              <metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parking lot around the spawn point: 20 x 17 m of asphalt, two rows of 2.5 x 5 m bays either
         side of a 6 m aisle, the vehicle in the middle of the aisle. Visual only, a few mm above
         the grass, so the vehicle still rests on the plane. -->
    <model name="parking_lot">
      <static>true</static>
      <link name="link">
        <visual name="asphalt">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><mesh><uri>model://ground/meshes/asphalt.obj</uri></mesh></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://ground/materials/asphalt.jpg</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
        <visual name="line_n0"><pose>-8.75 5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_n1"><pose>-6.25 5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_n2"><pose>-3.75 5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_n3"><pose>-1.25 5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_n4"><pose>1.25 5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_n5"><pose>3.75 5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_n6"><pose>6.25 5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_n7"><pose>8.75 5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_s0"><pose>-8.75 -5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_s1"><pose>-6.25 -5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_s2"><pose>-3.75 -5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_s3"><pose>-1.25 -5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_s4"><pose>1.25 -5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_s5"><pose>3.75 -5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_s6"><pose>6.25 -5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
        <visual name="line_s7"><pose>8.75 -5.5 0.0035 0 0 0</pose><geometry><box><size>0.12 5 0.001</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Trees 12-28 m out (positions from a fixed seed). -->
    <include><uri>model://round_tree</uri><name>tree_1</name><pose>20.6 -1.6 0 0 0 2.32</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_2</name><pose>20.1 9.1 0 0 0 0.41</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_3</name><pose>20.4 15.2 0 0 0 1.63</pose></include>
    <include><uri>model://round_tree</uri><name>tree_4</name><pose>12.7 24.9 0 0 0 2.95</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_5</name><pose>-2.0 19.5 0 0 0 4.01</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_6</name><pose>-6.3 21.2 0 0 0 5.45</pose></include>
    <include><uri>model://round_tree</uri><name>tree_7</name><pose>-17.0 16.8 0 0 0 4.22</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_8</name><pose>-20.9 12.1 0 0 0 3.71</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_9</name><pose>-12.5 0.7 0 0 0 5.44</pose></include>
    <include><uri>model://round_tree</uri><name>tree_10</name><pose>-21.8 -8.8 0 0 0 5.52</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_11</name><pose>-17.7 -20.1 0 0 0 2.48</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_12</name><pose>-5.7 -18.2 0 0 0 5.88</pose></include>
    <include><uri>model://round_tree</uri><name>tree_13</name><pose>1.5 -13.5 0 0 0 0.85</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_14</name><pose>8.3 -26.2 0 0 0 2.74</pose></include>
    <include><uri>model://pine_tree</uri><name>tree_15</name><pose>12.3 -11.4 0 0 0 3.19</pose></include>
    <include><uri>model://round_tree</uri><name>tree_16</name><pose>16.0 -7.3 0 0 0 3.67</pose></include>
  </world>
</sdf>
