<?xml version="1.0"?>
<!--
  Tilted-rotor hexacopter (RPIC17 / ICRIS18), primitives only.
  Render with: xacro ft_tilt.sdf.xacro gamma_deg:=107 failure_gains:=mild allocation:=null_space

  Frame: FLU, origin at the centre of mass. Motor i (1..6) sits on the arm at (i-1)·60° from +x
  toward +y. Its spin axis is cos(γ)·d̂ + sin(γ)·ẑ, so γ = 107° leans it 17° toward the centre
  (arms tilted up, as on the real vehicle) and γ = 90° is the standard hexacopter.
-->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="name" default="ft_tilt"/>
  <xacro:arg name="gamma_deg" default="107"/>
  <xacro:arg name="failure_gains" default="mild"/>
  <xacro:arg name="battery" default="3s"/>
  <xacro:arg name="allocation" default="null_space"/>  <!-- null_space | pinv_clamp -->

  <!-- RPIC17 Table I and ICRIS18 §IV -->
  <xacro:property name="tilt" value="${radians($(arg gamma_deg))}"/>
  <xacro:property name="arm" value="0.26"/>
  <xacro:property name="mass" value="2.1"/>
  <xacro:property name="jxy" value="0.0476"/>
  <!-- ICRIS18 identifies Jz = 0.1094, but Jx + Jy = 0.0952 < Jz is not a rigid body. Use
       the flat-plate limit Jz ≈ Jx + Jy instead (roll/pitch values kept). -->
  <xacro:property name="jz" value="${0.999 * 2 * jxy}"/>
  <!-- battery:=3s is RPIC17 Table I (measured). With it the vehicle hovers on 5 motors with
       motor 3 at ~96 % of F_M, which is why RPIC17 only tested a partial fault.
       battery:=4s is ICRIS18's total-failure vehicle. The paper gives no numbers, so this is
       an ESTIMATE from its Fig. 11: healthy motors hover at ~65 % PWM carrying ~5.4 N each,
       giving k_f ≈ 0.083 N/% and F_M ≈ k_f·100 %. A typo in battery fails the render. -->
  <xacro:property name="battery" value="$(arg battery)"/>
  <xacro:unless value="${battery in ['3s', '4s']}">${xacro.fatal('battery must be 3s or 4s')}</xacro:unless>
  <xacro:property name="kf" value="${0.0776 if battery == '3s' else 0.083}"/>  <!-- N per % PWM -->
  <xacro:property name="max_force" value="${0.644 * 9.80665 if battery == '3s' else 8.3}"/>  <!-- F_M -->
  <xacro:property name="kt_ratio" value="${0.0077 / 0.0776}"/>  <!-- k̃t = kt/kf (m), both batteries -->
  <xacro:property name="motor_tau" value="${1 / 20.06}"/>  <!-- identified actuator pole p -->
  <!-- Assumed: the papers give no rotor speed. Only the speed scale depends on this. -->
  <xacro:property name="max_rot_velocity" value="1000.0"/>
  <xacro:property name="motor_constant" value="${max_force / max_rot_velocity**2}"/>

  <xacro:property name="rotor_mass" value="0.01"/>
  <xacro:property name="base_mass" value="${mass - 6 * rotor_mass}"/>
  <!-- Base inertia so that base + rotor point masses give the identified Jx = Jy, Jz. -->
  <xacro:property name="base_ixx" value="${jxy - 3 * rotor_mass * arm**2}"/>
  <xacro:property name="base_izz" value="${jz - 6 * rotor_mass * arm**2}"/>

  <xacro:macro name="rotor" params="i spin">
    <xacro:property name="th" value="${(i - 1) * pi / 3}"/>
    <link name="rotor_${i}">
      <!-- z axis = thrust axis; the motor model pushes along it. -->
      <pose relative_to="base_link">${arm * cos(th)} ${arm * sin(th)} 0 0 ${pi / 2 - tilt} ${th}</pose>
      <inertial>
        <mass>${rotor_mass}</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Motor look: Hawk's Work A2212 920KV (same 2212/920KV class as RPIC17's T-Motor),
           modelled in Blender (Ø27.7 x 30 mm). Sleeve, red cap/shaft and spinner turn with the prop. -->
      <visual name="band">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/motor_band.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="bell">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/motor_bell.stl</uri></mesh></geometry>
        <material><ambient>0.7 0.04 0.04 1</ambient><diffuse>0.7 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="spinner">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/motor_spinner.stl</uri></mesh></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material>
      </visual>
      <!-- E-Prop 10x4.5 mesh from PX4's 3DR Iris model (PX4-SITL_gazebo-classic, BSD), scaled
           to the F550's 9.4" (239 mm) props. Red = cw (motors 1, 3, 5), black = ccw. -->
      <visual name="prop">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://$(find ft_tilt_description)/meshes/iris_prop_${'cw' if spin > 0 else 'ccw'}.dae</uri>
            <scale>${0.239 / 0.2577} ${0.239 / 0.2577} ${0.239 / 0.2577}</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>${'0.8 0.1 0.1 1' if spin > 0 else '0.1 0.1 0.1 1'}</ambient>
          <diffuse>${'0.8 0.1 0.1 1' if spin > 0 else '0.1 0.1 0.1 1'}</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_${i}_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_${i}</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <!-- Gazebo: cw → reaction torque +k̃t·f about the thrust axis, i.e. spin = +1. -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_${i}_joint</jointName>
      <linkName>rotor_${i}</linkName>
      <turningDirection>${'cw' if spin > 0 else 'ccw'}</turningDirection>
      <timeConstantUp>${motor_tau}</timeConstantUp>
      <timeConstantDown>${motor_tau}</timeConstantDown>
      <maxRotVelocity>${max_rot_velocity}</maxRotVelocity>
      <motorConstant>${motor_constant}</motorConstant>
      <momentConstant>${kt_ratio}</momentConstant>
      <actuator_number>${i - 1}</actuator_number>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorSpeedPubTopic>motor_speed/${i}</motorSpeedPubTopic>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </xacro:macro>

  <xacro:macro name="motor_mount" params="i">
    <xacro:property name="th" value="${(i - 1) * pi / 3}"/>
    <!-- 3D-printed adapter and motor base, tilted with the rotor axis (RPIC17 Fig. 4). -->
    <xacro:property name="ax" value="${cos(tilt) * cos(th)}"/>
    <xacro:property name="ay" value="${cos(tilt) * sin(th)}"/>
    <xacro:property name="az" value="${sin(tilt)}"/>
    <!-- A2212 base and stator windings: the static half of meshes/motor_*.stl. -->
    <visual name="motor_${i}">
      <pose>${arm * cos(th)} ${arm * sin(th)} 0 0 ${pi / 2 - tilt} ${th}</pose>
      <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/motor_base.stl</uri></mesh></geometry>
      <material><ambient>0.7 0.04 0.04 1</ambient><diffuse>0.7 0.04 0.04 1</diffuse></material>
    </visual>
    <visual name="stator_${i}">
      <pose>${arm * cos(th)} ${arm * sin(th)} 0 0 ${pi / 2 - tilt} ${th}</pose>
      <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/motor_stator.stl</uri></mesh></geometry>
      <material><ambient>0.72 0.45 0.2 1</ambient><diffuse>0.72 0.45 0.2 1</diffuse></material>
    </visual>
    <!-- 17° printed wedge (meshes/adapter.stl, built for 107°, turned 180° for 73°); other γ get
         a spacer square to the axis (flat at 90°). -->
    <xacro:property name="wedge" value="${$(arg gamma_deg) in [73, 107]}"/>
    <visual name="adapter_${i}">
      <xacro:if value="${wedge}">
        <pose>${arm * cos(th)} ${arm * sin(th)} 0 0 0 ${th + (0 if $(arg gamma_deg) > 90 else pi)}</pose>
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/adapter.stl</uri></mesh></geometry>
      </xacro:if>
      <xacro:unless value="${wedge}">
        <pose>${arm * cos(th) - 0.0313 * ax} ${arm * sin(th) - 0.0313 * ay} ${-0.0313 * az} 0 ${pi / 2 - tilt} ${th}</pose>
        <geometry><box><size>0.04 0.03 0.010</size></box></geometry>
      </xacro:unless>
      <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
    </visual>
  </xacro:macro>

  <model name="$(arg name)">
    <link name="base_link">
      <inertial>
        <mass>${base_mass}</mass>
        <inertia>
          <ixx>${base_ixx}</ixx><iyy>${base_ixx}</iyy><izz>${base_izz}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <pose>0 0 -0.115 0 0 0</pose>  <!-- down to the F550 skids at z = -0.215 -->
        <geometry><cylinder><radius>0.15</radius><length>0.2</length></cylinder></geometry>
      </collision>
      <!-- DJI F550 frame, "DJI Flame Wheel F550" by An Dré (Printables 1436460, public domain).
           Motors, props and GPS mast removed, faces turned outward, rotated -30° so arm i holds motor i, scaled so the motor
           pads sit at the papers' 0.26 m (F550: 0.273 m). Arm 1 (+x) is red. -->
      <visual name="f550_body">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/f550_body.stl</uri></mesh></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><double_sided>true</double_sided></material>
      </visual>
      <visual name="f550_arm1">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/f550_arm1.stl</uri></mesh></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse><double_sided>true</double_sided></material>
      </visual>
      <visual name="f550_arms">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/f550_arms.stl</uri></mesh></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse><double_sided>true</double_sided></material>
      </visual>
      <!-- Jetson Orin Nano/NX developer kit (P3768 carrier, P3767 module, fan cooler) from NVIDIA's
           dev kit STEP, without its plastic tray and antennas, on 8 mm standoffs, I/O toward the back.
           Visual only: mass and inertia unchanged. -->
      <visual name="jetson_pcb">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_pcb.stl</uri></mesh></geometry>
        <material><ambient>0.07 0.08 0.07 1</ambient><diffuse>0.07 0.08 0.07 1</diffuse></material>
      </visual>
      <visual name="jetson_metal">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_metal.stl</uri></mesh></geometry>
        <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
      <visual name="jetson_white">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_white.stl</uri></mesh></geometry>
        <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
      </visual>
      <visual name="jetson_dark">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_dark.stl</uri></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="jetson_cooler">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_cooler.stl</uri></mesh></geometry>
        <material><ambient>0.36 0.43 0.52 1</ambient><diffuse>0.36 0.43 0.52 1</diffuse></material>
      </visual>
      <visual name="jetson_red">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_red.stl</uri></mesh></geometry>
        <material><ambient>0.75 0.2 0.05 1</ambient><diffuse>0.75 0.2 0.05 1</diffuse></material>
      </visual>
      <visual name="jetson_blue">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_blue.stl</uri></mesh></geometry>
        <material><ambient>0.1 0.25 0.85 1</ambient><diffuse>0.1 0.25 0.85 1</diffuse></material>
      </visual>
      <visual name="jetson_green">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_green.stl</uri></mesh></geometry>
        <material><ambient>0.2 0.6 0.35 1</ambient><diffuse>0.2 0.6 0.35 1</diffuse></material>
      </visual>
      <visual name="jetson_gold">
        <geometry><mesh><uri>file://$(find ft_tilt_description)/meshes/jetson_gold.stl</uri></mesh></geometry>
        <material><ambient>0.85 0.65 0.2 1</ambient><diffuse>0.85 0.65 0.2 1</diffuse></material>
      </visual>
      <xacro:motor_mount i="1"/>
      <xacro:motor_mount i="2"/>
      <xacro:motor_mount i="3"/>
      <xacro:motor_mount i="4"/>
      <xacro:motor_mount i="5"/>
      <xacro:motor_mount i="6"/>
    </link>

    <!-- Spin (-1)^(i+1): motor 1 cw, then alternating. -->
    <xacro:rotor i="1" spin="1"/>
    <xacro:rotor i="2" spin="-1"/>
    <xacro:rotor i="3" spin="1"/>
    <xacro:rotor i="4" spin="-1"/>
    <xacro:rotor i="5" spin="1"/>
    <xacro:rotor i="6" spin="-1"/>

    <plugin filename="ft_tilt_controller" name="ft_tilt::FtTiltController">
      <base_link>base_link</base_link>
      <rotor><link>rotor_1</link><spin>1</spin></rotor>
      <rotor><link>rotor_2</link><spin>-1</spin></rotor>
      <rotor><link>rotor_3</link><spin>1</spin></rotor>
      <rotor><link>rotor_4</link><spin>-1</spin></rotor>
      <rotor><link>rotor_5</link><spin>1</spin></rotor>
      <rotor><link>rotor_6</link><spin>-1</spin></rotor>
      <kt_ratio>${kt_ratio}</kt_ratio>
      <kf>${kf}</kf>
      <max_force>${max_force}</max_force>
      <motor_constant>${motor_constant}</motor_constant>
      <pwm_floor>14</pwm_floor>
      <rate>200</rate>
      <xacro:unless value="${'$(arg failure_gains)' in ['mild', 'aggressive', 'rpic17']}">${xacro.fatal('failure_gains must be mild, aggressive or rpic17')}</xacro:unless>
      <failure_gains>$(arg failure_gains)</failure_gains>
      <xacro:unless value="${'$(arg allocation)' in ['null_space', 'pinv_clamp']}">${xacro.fatal('allocation must be null_space or pinv_clamp')}</xacro:unless>
      <allocation>$(arg allocation)</allocation>
    </plugin>

    <!-- Ground-truth odometry for the experiment runner's altitude hold. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>200</odom_publish_frequency>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </model>
</sdf>
