<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ft_tilt_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic system plugin running the tilted hexacopter's attitude PID and fault-tolerant allocation</description>
  <maintainer email="alvgaona@gmail.com">Alvaro Gaona</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ft_tilt_control</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
